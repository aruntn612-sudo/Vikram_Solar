using Microsoft.Playwright;
using NUnit.Framework;
using System.Text.RegularExpressions;

namespace Vikram_Solar
{
    [Parallelizable(ParallelScope.Self)]
    [TestFixture]
    public class Tests : PageTest
    {
        [Test]
        public async Task VerifyTheVsvikramSolarHomePageTitle()
        {
            await Page.GotoAsync("https://www.vsvikramsolar.in/");

            // Expect a title "to contain" a substring.
            await Expect(Page).ToHaveTitleAsync(new Regex("VSVIKRAMSOLAR – Solar | Inverter | Smart CCTV | Water Purifiers"));

 }
        [Test]
        public async Task VerifyTheToContactMobileNumberDisplayedOnThePage()
        {
            await Page.GotoAsync("https://www.vsvikramsolar.in/");

            string mobileNumber = await Page.GetByText("CALL +91 95917 26143").TextContentAsync();
            mobileNumber = mobileNumber.Split("+").LastOrDefault();
            Assert.That(mobileNumber, Is.EqualTo("91 95917 26143"));
        }
        [Test]
        public async Task VerifyTheAboutUsLinkPage()
        {
            await Page.GotoAsync("https://www.vsvikramsolar.in/");

            // Wait for page to stabilize with multiple strategies
            await Page.WaitForLoadStateAsync(LoadState.NetworkIdle);
            // Additional wait for dynamic JavaScript-rendered content
            await Page.WaitForTimeoutAsync(2000);

            // Debug: Take a screenshot to see current state
            await Page.ScreenshotAsync(new PageScreenshotOptions { Path = "debug_screenshot.png" });

            // Try primary strategy: data-testid attribute
            var locator = Page.GetByTestId("menu-item-31");
            int elementCount = await locator.CountAsync();
            Console.WriteLine($"Elements found with testid='menu-item-31': {elementCount}");

            // Debug: List all elements with data-testid attribute
            var allTestIds = await Page.Locator("[data-testid]").CountAsync();
            Console.WriteLine($"Total elements with data-testid: {allTestIds}");

            // If element found via testid, click it
            if (elementCount > 0)
            {
                bool isVisible = await locator.IsVisibleAsync();
                Console.WriteLine($"Element visible: {isVisible}");

                if (isVisible)
                {
                    await locator.ClickAsync();
                }
                else
                {
                    Console.WriteLine("Element found but not visible!");
                    throw new Exception("Menu item found but not visible on page");
                }
            }
            else
            {
                Console.WriteLine("Element not found with testid. Trying alternative selectors...");

                // Fallback strategy 1: Find by "About Us" text
                var aboutUsText = Page.Locator("text=/About\\s*Us/i");
                int aboutUsCount = await aboutUsText.CountAsync();

                if (aboutUsCount > 0)
                {
                    Console.WriteLine("Found 'About Us' using text selector");
                    await aboutUsText.FirstAsync().ClickAsync();
                }
                else
                {
                    // Fallback strategy 2: Find by href containing "about"
                    var aboutLink = Page.Locator("a[href*='about' i]");
                    int aboutLinkCount = await aboutLink.CountAsync();

                    if (aboutLinkCount > 0)
                    {
                        Console.WriteLine("Found About link using href selector");
                        await aboutLink.FirstAsync().ClickAsync();
                    }
                    else
                    {
                        // Fallback strategy 3: Check if menu needs to be opened first (mobile)
                        var menuToggle = Page.Locator("button[aria-label*='menu' i], .hamburger, [class*='menu-toggle']");
                        int toggleCount = await menuToggle.CountAsync();

                        if (toggleCount > 0)
                        {
                            Console.WriteLine("Opening menu button...");
                            await menuToggle.FirstAsync().ClickAsync();
                            await Page.WaitForTimeoutAsync(500);

                            // Retry finding About Us
                            aboutUsText = Page.Locator("text=/About\\s*Us/i");
                            aboutUsCount = await aboutUsText.CountAsync();

                            if (aboutUsCount > 0)
                            {
                                Console.WriteLine("Found 'About Us' in menu after toggle");
                                await aboutUsText.FirstAsync().ClickAsync();
                            }
                            else
                            {
                                throw new Exception("Menu item with testid='menu-item-31' not found, and no alternative 'About Us' link found on page");
                            }
                        }
                        else
                        {
                            throw new Exception("Menu item with testid='menu-item-31' not found on page");
                        }
                    }
                }
            }

            // Wait for navigation to complete
            await Page.WaitForLoadStateAsync(LoadState.NetworkIdle);

            // Expects the URL to contain About
            await Expect(Page).ToHaveURLAsync(new Regex("About", RegexOptions.IgnoreCase));
        }
        [Test]
        public async Task HomepageHasPlaywrightInTitleAndGetStartedLinkLinkingtoTheIntroPage()
        {
            await Page.GotoAsync("https://playwright.dev");

            // Expect a title "to contain" a substring.
            await Expect(Page).ToHaveTitleAsync(new Regex("Playwright"));

            // create a locator
            var getStarted = Page.Locator("text=Get Started");

            // Expect an attribute "to be strictly equal" to the value.
            await Expect(getStarted).ToHaveAttributeAsync("href", "/docs/intro");

            // Click the get started link.
            await getStarted.ClickAsync();

            // Expects the URL to contain intro.
            await Expect(Page).ToHaveURLAsync(new Regex(".*intro"));
        }
    }
}
